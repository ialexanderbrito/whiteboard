{
  "rules": {
    "presence": {
      "$boardId": {
        ".read": "auth != null",
        "$userId": {
          ".write": "auth != null && (auth.uid === $userId || auth.uid === newData.child('userId').val() || (data.exists() && !newData.exists() && auth.uid === $userId))",
          ".validate": "newData.hasChildren(['userId', 'name', 'color'])",
          "userId": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
          },
          "color": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          },
          "cursor": {
            ".validate": "newData.val() === null || (newData.hasChildren(['x', 'y']) && newData.child('x').isNumber() && newData.child('y').isNumber())"
          },
          "selectedElementId": {
            ".validate": "newData.val() === null || newData.isString()"
          },
          "lastSeen": {
            ".validate": "newData.val() === null || newData.isNumber()"
          }
        }
      }
    },
    "board_timer": {
      "$boardId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "board_voting": {
      "$boardId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "global_reactions": {
      "$boardId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
