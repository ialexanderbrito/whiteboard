{
  "rules": {
    "presence": {
      "$boardId": {
        ".read": "auth != null",
        "$userId": {
          ".write": "auth != null && auth.uid === $userId",
          ".validate": "newData.hasChildren(['userId', 'name', 'color'])",
          "userId": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
          },
          "color": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          },
          "photoURL": {
            ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 2048)"
          },
          "isAnonymous": {
            ".validate": "newData.val() === null || newData.isBoolean()"
          },
          "activeTool": {
            ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 32)"
          },
          "cursor": {
            ".validate": "newData.val() === null || (newData.hasChildren(['x', 'y']) && newData.child('x').isNumber() && newData.child('y').isNumber())"
          },
          "laser": {
            ".validate": "newData.val() === null || (newData.hasChildren(['isDrawing', 'timestamp']) && newData.child('isDrawing').isBoolean() && newData.child('timestamp').isNumber())"
          },
          "selectedElementId": {
            ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 64)"
          },
          "message": {
            ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 280)"
          },
          "messageTimestamp": {
            ".validate": "newData.val() === null || newData.isNumber()"
          },
          "lastClickTimestamp": {
            ".validate": "newData.val() === null || newData.isNumber()"
          },
          "reaction": {
            ".validate": "newData.val() === null || (newData.hasChildren(['id', 'emoji', 'timestamp']) && newData.child('id').isString() && newData.child('emoji').isString() && newData.child('emoji').val().length <= 32 && newData.child('timestamp').isNumber())"
          },
          "lastSeen": {
            ".validate": "newData.val() === null || newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "board_timer": {
      "$boardId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['durationSeconds', 'remainingSeconds', 'isRunning'])",
        "durationSeconds": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
        },
        "remainingSeconds": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
        },
        "isRunning": {
          ".validate": "newData.isBoolean()"
        },
        "startedAt": {
          ".validate": "newData.val() === null || newData.isNumber()"
        },
        "endsAt": {
          ".validate": "newData.val() === null || newData.isNumber()"
        },
        "updatedByName": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 50)"
        },
        "youtubeUrl": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 256)"
        },
        "musicEnabled": {
          ".validate": "newData.val() === null || newData.isBoolean()"
        },
        "volume": {
          ".validate": "newData.val() === null || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100)"
        },
        "isOpenForEveryone": {
          ".validate": "newData.val() === null || newData.isBoolean()"
        },
        "lastAction": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 32)"
        },
        "lastActionTimestamp": {
          ".validate": "newData.val() === null || newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "board_voting": {
      "$boardId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "session": {
          ".validate": "newData.val() === null || (newData.hasChildren(['id', 'status']) && newData.child('id').isString() && newData.child('status').isString())"
        },
        "previousSessions": {
          ".validate": true
        },
        "votesByUser": {
          ".validate": true
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "global_reactions": {
      "$boardId": {
        ".read": "auth != null",
        "$eventId": {
          ".write": "auth != null && (newData.child('userId').val() === auth.uid || (data.exists() && !newData.exists()))",
          ".validate": "newData.hasChildren(['id', 'userId', 'emoji', 'reaction', 'timestamp']) && newData.child('userId').val() === auth.uid && newData.child('emoji').isString() && newData.child('emoji').val().length <= 32 && newData.child('reaction').isString() && newData.child('reaction').val().length <= 32 && newData.child('timestamp').isNumber()",
          "id": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "userId": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "userName": { ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 50)" },
          "emoji": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "reaction": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "timestamp": { ".validate": "newData.isNumber()" },
          "originX": { ".validate": "newData.val() === null || newData.isNumber()" },
          "originY": { ".validate": "newData.val() === null || newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
