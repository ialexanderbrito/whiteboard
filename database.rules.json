{
  "rules": {
    "presence": {
      "$boardId": {
        ".read": "true",
        "$userId": {
          ".write": "true",
          ".validate": "newData.hasChildren(['userId', 'name', 'color'])",
          "userId": {
            ".validate": "newData.isString()"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
          },
          "color": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          },
          "cursor": {
            ".validate": "newData.val() === null || (newData.hasChildren(['x', 'y']) && newData.child('x').isNumber() && newData.child('y').isNumber())"
          },
          "selectedElementId": {
            ".validate": "newData.val() === null || newData.isString()"
          },
          "lastSeen": {
            ".validate": "newData.val() === null || newData.isNumber()"
          }
        }
      }
    },
    "board_timer": {
      "$boardId": {
        ".read": "true",
        ".write": "true"
      }
    },
    "board_voting": {
      "$boardId": {
        ".read": "true",
        ".write": "true"
      }
    },
    "global_reactions": {
      "$boardId": {
        ".read": "true",
        ".write": "true"
      }
    }
  }
}
