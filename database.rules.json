{
  "rules": {
    "presence": {
      "$boardId": {
        ".read": "auth != null",
        "$userId": {
          ".write": "auth != null && (auth.uid === $userId || auth.uid === newData.child('userId').val() || (data.exists() && !newData.exists() && auth.uid === $userId))",
          ".validate": "newData.hasChildren(['userId', 'name', 'color'])",
          "userId": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
          },
          "color": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          },
          "cursor": {
            ".validate": "newData.val() === null || (newData.hasChildren(['x', 'y']) && newData.child('x').isNumber() && newData.child('y').isNumber())"
          },
          "selectedElementId": {
            ".validate": "newData.val() === null || newData.isString()"
          },
          "lastSeen": {
            ".validate": "newData.val() === null || newData.isNumber()"
          }
        }
      }
    },
    "board_timer": {
      "$boardId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['durationSeconds', 'remainingSeconds', 'isRunning'])",
        "durationSeconds": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
        },
        "remainingSeconds": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
        },
        "isRunning": {
          ".validate": "newData.isBoolean()"
        },
        "startedAt": {
          ".validate": "newData.val() === null || newData.isNumber()"
        },
        "endsAt": {
          ".validate": "newData.val() === null || newData.isNumber()"
        },
        "updatedByName": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 50)"
        },
        "youtubeUrl": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 256)"
        },
        "musicEnabled": {
          ".validate": "newData.val() === null || newData.isBoolean()"
        },
        "volume": {
          ".validate": "newData.val() === null || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100)"
        },
        "isOpenForEveryone": {
          ".validate": "newData.val() === null || newData.isBoolean()"
        },
        "lastAction": {
          ".validate": "newData.val() === null || newData.isString()"
        },
        "lastActionTimestamp": {
          ".validate": "newData.val() === null || newData.isNumber()"
        }
      }
    },
    "board_voting": {
      "$boardId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.val() === null || newData.hasChildren()",
        "session": {
          ".validate": "newData.val() === null || (newData.hasChildren(['id', 'status']) && newData.child('id').isString() && newData.child('status').isString())"
        }
      }
    },
    "global_reactions": {
      "$boardId": {
        ".read": "auth != null",
        "$eventId": {
          ".write": "auth != null && (newData.child('userId').val() === auth.uid || (data.exists() && !newData.exists()))",
          ".validate": "newData.val() === null || (newData.hasChildren(['userId', 'reaction', 'timestamp']) && newData.child('userId').val() === auth.uid && newData.child('reaction').isString() && newData.child('reaction').val().length <= 32 && newData.child('timestamp').isNumber())"
        }
      }
    }
  }
}
