rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar: usuário logado (Google ou Convidado anônimo)
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Coleção de quadros (/boards/{boardId})
    match /boards/{boardId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() 
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;
      
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        !('ownerId' in resource.data) ||
        resource.data.ownerId == null ||
        resource.data.ownerId == ''
      );
      
      // Subcoleção de elementos do canvas (/boards/{boardId}/elements/{elementId})
      match /elements/{elementId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated();
        allow delete: if isAuthenticated();
      }
    }
  }
}
